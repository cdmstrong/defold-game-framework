fonts { name: "zh" font: "/assets/fonts/zh.font" }
material: "/builtins/materials/gui.material"
script: "/menu/menu.gui_script"
max_nodes: 32
nodes { id: "menu_root" type: TYPE_BOX position { x: 270 y: 480 z: 0 } size { x: 540 y: 960 z: 0 } color { x: 0.07 y: 0.1 z: 0.17 w: 1 } }
nodes { id: "header" type: TYPE_BOX parent: "menu_root" position { x: 0 y: 350 z: 0.1 } size { x: 540 y: 280 z: 0 } color { x: 0.11 y: 0.17 z: 0.28 w: 1 } }
nodes { id: "title" type: TYPE_TEXT parent: "menu_root" position { x: 0 y: 392 z: 0.2 } size { x: 520 y: 80 z: 0 } color { x: 1 y: 1 z: 1 w: 1 } text: "SKY CLIMBER" font: "zh" scale { x: 1.5 y: 1.5 z: 0.1 } outline { x: 0 y: 0 z: 0 w: 1 } }
nodes { id: "subtitle" type: TYPE_TEXT parent: "menu_root" position { x: 0 y: 330 z: 0.2 } size { x: 520 y: 40 z: 0 } color { x: 0.62 y: 0.75 z: 0.92 w: 1 } text: "高空攀爬 · 无限挑战" font: "zh" scale { x: 0.75 y: 0.75 z: 0.1 } outline { x: 0 y: 0 z: 0 w: 1 } }
