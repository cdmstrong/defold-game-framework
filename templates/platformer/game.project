[project]
title = Sky Climber
version = 0.4.0
dependencies#0 = https://codeload.github.com/cdmstrong/defold-game-framework/zip/bee93ba531c1e02e5a0eedc893ff8bcaec0caf61
dependencies#1 = https://codeload.github.com/Insality/druid/zip/9a5171377fc2f7fba68fea4f2c117ee6a25d28a4
dependencies#2 = https://codeload.github.com/britzl/monarch/zip/5c33c39830489925493163e741d5b22b4e5e3b9d
dependencies#3 = https://codeload.github.com/Insality/defold-event/zip/384813497c25ff41d34ab1efdb1163217dc9dd26

[bootstrap]
main_collection = /main.collectionc

[input]
game_binding = /input/game.input_bindingc
use_accelerometer = 0

[display]
width = 540
height = 960
vsync = 0
update_frequency = 60
high_dpi = 1

[script]
shared_state = 1

[render]
clear_color_red = 0.42
clear_color_green = 0.68
clear_color_blue = 0.89
clear_color_alpha = 1.0

[html5]
scale_mode = fit
